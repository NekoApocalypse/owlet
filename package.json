{
  "name": "owlet",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "description": "A focused reader and editor for agent work, locally or over SSH",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/generate-icon.cjs && tsc --noEmit && vite build",
    "start": "electron .",
    "test:remote": "node --test tests/remote.test.cjs",
    "test:local": "node --test tests/local.test.cjs",
    "source:export": "node scripts/export-source.cjs",
    "test:ui": "node tests/ui.cjs",
    "test:performance": "node tests/performance.cjs",
    "package": "node scripts/package.cjs",
    "format": "prettier --write src electron scripts tests vite.config.ts package.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "mark.js": "^8.11.1",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/katex": "^0.16.8",
    "@types/mark.js": "^8.11.12",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.2.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "resedit": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
